# Base Code Arena: environment for the Node server (src/server/config.js validates every value and refuses bad ones).
# Copy to .env for local work; CI and the Base44 actor set these themselves. Never commit a real .env.

# Port and interface for the dev / self-hosted server
PORT=3000
HOST=0.0.0.0

# development | production. Production requires ALLOWED_ORIGINS.
NODE_ENV=development

# Comma separated browser origins allowed to open the WebSocket (exact scheme://host[:port]); empty = same origin only
ALLOWED_ORIGINS=http://localhost:3000

# error | warn | info | debug
LOG_LEVEL=info

# Bots filling seats while a human is present (SPEC 35.3). Empty = the mode default (dm 2, tdm 4, range 4); 0 = none
BOT_FILL=
