{
  "name": "base-code-project-game",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Multiplayer 3D FPS: authoritative Node/ws server + Three.js client, single port.",
  "scripts": {
    "dev": "vite",
    "dev:server": "node src/server/index.js",
    "build": "vite build",
    "start": "NODE_ENV=production node src/server/index.js",
    "lint": "node scripts/check-policy.mjs && node scripts/check-agents-md.mjs && eslint .",
    "test": "node scripts/run-tests.mjs all",
    "test:dry": "npm run lint && npm run test:unit && npm run test:regression",
    "test:live": "npm run test:integration && npm run test:security && npm run test:system && npm run test:stress",
    "smoke": "node scripts/smoke.mjs",
    "actor-probe": "node scripts/actor-probe.mjs",
    "test:unit": "node scripts/run-tests.mjs unit",
    "test:integration": "node scripts/run-tests.mjs integration",
    "test:system": "node scripts/run-tests.mjs system",
    "test:security": "node scripts/run-tests.mjs security",
    "test:stress": "node scripts/run-tests.mjs stress",
    "test:regression": "node scripts/run-tests.mjs regression",
    "test:latency": "node scripts/run-tests.mjs latency",
    "coverage": "node scripts/run-tests.mjs all --coverage",
    "audit:deps": "npm audit --audit-level=high",
    "verify": "npm run lint && npm test",
    "hooks": "sh scripts/setup-hooks.sh"
  },
  "dependencies": {
    "@base44/sdk": "^0.8.52",
    "@base44/vite-plugin": "^1.0.44",
    "three": "0.185.1",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "vite": "8.2.2"
  },
  "engines": {
    "node": ">=22"
  }
}
